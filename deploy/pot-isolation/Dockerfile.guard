FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39
RUN apt-get update && apt-get install -y --no-install-recommends nftables iproute2 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/muse-guard
COPY deploy/pot-isolation/net_guard.py ./
RUN chmod 0555 /opt/muse-guard/net_guard.py
ENV PYTHONDONTWRITEBYTECODE=1
# Trusted firewall-only process. Never contains provider code or production state.
USER 0:0
HEALTHCHECK --interval=2s --timeout=5s --start-period=2s --retries=2 CMD ["python3", "/opt/muse-guard/net_guard.py", "--health"]
ENTRYPOINT ["python3", "/opt/muse-guard/net_guard.py"]
